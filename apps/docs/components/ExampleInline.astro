---
// Overrides Blume's built-in <Component /> (see components.ts): renders the
// example INLINE in the docs page instead of inside an isolated iframe, so
// portaled UI (dialogs, popovers, menus, toasts) escapes the preview box and
// overlays the whole site. The trade-off vs Blume's
// default: docs CSS could leak into examples, which we contain with
// `not-prose` on the preview pane.
import * as stylex from '@stylexjs/stylex';
import data from 'blume:data';
import { examples } from 'blume:examples';
import Tab from 'blume/components/content/Tab.astro';
import Tabs from 'blume/components/content/Tabs.astro';
import { highlightCode } from 'blume/markdown';

import { darkTheme } from '@/lib/themes';

interface Props {
  path: string;
}

const { path } = Astro.props;
const entry = examples[path];
const Example = entry?.Component;

const codeHtml = entry
  ? await highlightCode(entry.code, entry.lang, {
      className: 'blume-source',
      themes: data.config.codeThemes,
    })
  : undefined;

// The StyleX dark-theme classes, resolved server-side so the inline script
// below can apply them BEFORE first paint (a useEffect would flash light).
const darkClasses = stylex.props(darkTheme).className ?? '';
---

{
  entry ? (
    <Tabs hash={false} sync={false}>
      <Tab class="not-prose p-0!" title="Preview">
        {/* Mirrors Blume's data-theme onto the StyleX dark theme synchronously
            (inline scripts block parsing, so previews below never paint in the
            wrong theme) and keeps following toggles via a MutationObserver.
            Runs once per page — later instances see the guard. */}
        <script is:inline define:vars={{ darkClasses }}>
          (() => {
            if (window.__uiLibThemeSync) return;
            window.__uiLibThemeSync = true;
            const html = document.documentElement;
            const classes = darkClasses.split(' ').filter(Boolean);
            const apply = () => {
              const dark = html.dataset.theme === 'dark';
              for (const c of classes) html.classList.toggle(c, dark);
            };
            apply();
            new MutationObserver(apply).observe(html, {
              attributes: true,
              attributeFilter: ['data-theme'],
            });
            // Client-side navigation replaces <html>'s attributes with the new
            // page's, which has no StyleX classes. Re-applying after the swap
            // is too late: one style recalc happens with light tokens, and the
            // components' 150ms background transitions animate the correction
            // into a visible flash. Instead, stamp the theme onto the incoming
            // document BEFORE the swap so no recalc ever sees light values.
            document.addEventListener('astro:before-swap', (e) => {
              if (html.dataset.theme !== 'dark') return;
              const next = e.newDocument.documentElement;
              next.dataset.theme = 'dark';
              for (const c of classes) next.classList.add(c);
            });
            // Fallback for anything that still slips through.
            document.addEventListener('astro:after-swap', apply);
          })();
        </script>
        {/* Inline styles: Blume compiles this override outside the normal
            Astro page pipeline, so <style> blocks here are dropped. */}
        <div
          class="madeui-preview"
          style="align-items:center;display:flex;justify-content:center;min-height:10rem;padding:2.5rem 1.5rem;width:100%"
        >
          <Example />
        </div>
      </Tab>
      <Tab title="Code">
        <Fragment set:html={codeHtml} />
      </Tab>
    </Tabs>
  ) : (
    <div class="not-prose my-6 rounded-blume border border-border px-3 py-2 text-muted-foreground text-sm">
      No example found at <code class="font-mono">{path}</code>. Add it under{' '}
      <code class="font-mono">examples/</code> in your project.
    </div>
  )
}
