{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/components/ui/*": ["../../packages/registry/src/ui/*"],
      "@/lib/*": ["../../packages/registry/src/lib/*"],
      "@/components/site/*": ["./components/site/*"],
      "@/components/landing/*": ["./components/landing/*"],
      "@/site/*": ["./site/*"],
      "@examples/*": ["../../packages/registry/examples/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-vrt/types/**/*.ts",
    ".next-vrt/dev/types/**/*.ts",
    "../../packages/registry/src/**/*.ts",
    "../../packages/registry/src/**/*.tsx",
    "../../packages/registry/examples/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
