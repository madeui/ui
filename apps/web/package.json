{
  "name": "@madeui/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-registry.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-registry.mjs && pnpm check:inventory",
    "build": "next build",
    "start": "next start",
    "check:inventory": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-inventory.mts",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.5",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
