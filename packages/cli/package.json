{
  "name": "@madeui/cli",
  "version": "1.2.0",
  "description": "CLI for the madeui registry: init (StyleX build setup), add (install components), and diff (compare with the registry).",
  "keywords": [
    "ui",
    "components",
    "stylex",
    "base-ui",
    "react",
    "registry",
    "shadcn"
  ],
  "homepage": "https://madeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madeui/ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/madeui/ui/issues"
  },
  "type": "module",
  "bin": {
    "madeui": "dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepack": "tsdown"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "execa": "^10.0.1",
    "kleur": "^4.1.5",
    "ora": "^9.4.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/prompts": "^2.4.9",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
